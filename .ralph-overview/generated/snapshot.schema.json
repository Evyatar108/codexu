{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://codexu.local/schemas/overview-snapshot.v1.json",
  "title": "Ralph overview snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "generatedAt",
    "generatedFromCommit",
    "schemaVersion",
    "tasks",
    "runs",
    "recommendations",
    "dependencyGraph",
    "runDurations",
    "unmatched",
    "unmatchedSummary"
  ],
  "properties": {
    "generatedAt": {
      "type": "string"
    },
    "generatedFromCommit": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "tasks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SnapshotTask"
      }
    },
    "runs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/RunRecord"
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Recommendation"
      }
    },
    "dependencyGraph": {
      "$ref": "#/$defs/DependencyGraph"
    },
    "runDurations": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "unmatched": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/UnmatchedEntry"
      }
    },
    "unmatchedSummary": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    }
  },
  "$defs": {
    "OverviewWarning": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "html"
      ],
      "properties": {
        "className": {
          "type": "string"
        },
        "html": {
          "type": "string"
        }
      }
    },
    "OverviewCommand": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "descriptionHtml"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "descriptionHtml": {
          "type": "string"
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OverviewWarning"
          }
        },
        "prompts": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "brainstorm": {
              "type": "string"
            },
            "plan": {
              "type": "string"
            },
            "impl": {
              "type": "string"
            }
          }
        },
        "planPrompt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "KanbanCardData": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "html"
      ],
      "properties": {
        "column": {
          "type": "string"
        },
        "cardClass": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "inlineStyle": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "html": {
          "type": "string"
        },
        "insertBeforeTaskId": {
          "type": "string"
        },
        "order": {
          "type": "number"
        }
      }
    },
    "ShipManifestCommit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha",
        "oneLine"
      ],
      "properties": {
        "sha": {
          "type": "string"
        },
        "oneLine": {
          "type": "string"
        },
        "repo": {
          "type": "string"
        }
      }
    },
    "ShipManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shippedAt",
        "summary",
        "commits"
      ],
      "properties": {
        "shippedAt": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "commits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ShipManifestCommit"
          }
        }
      }
    },
    "OverviewTask": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "lifecycle": {
          "type": "string"
        },
        "phase": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "lastTouchedAt": {
          "type": "string"
        },
        "planOnly": {
          "type": "boolean"
        },
        "shipManifest": {
          "$ref": "#/$defs/ShipManifest"
        },
        "mergeCommit": {
          "type": "string"
        },
        "blocks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "blockedOn": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "members": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "initialStage": {
          "enum": [
            "brainstorming",
            "brainstorm-ready",
            "planning",
            "plan-ready",
            "implementing",
            "reviewing",
            "review-fix",
            "replan-pending",
            "shipped",
            "blocked"
          ]
        },
        "priority": {
          "type": "number"
        },
        "kanbanCards": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/KanbanCardData"
          }
        },
        "command": {
          "$ref": "#/$defs/OverviewCommand"
        }
      }
    },
    "RalphArtifacts": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "brainstormDir": {
          "type": "string"
        },
        "planDraftFile": {
          "type": "string"
        },
        "jobDir": {
          "type": "string"
        },
        "groupDir": {
          "type": "string"
        },
        "planFile": {
          "type": "string"
        },
        "prdFile": {
          "type": "string"
        }
      }
    },
    "StoryCompletion": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "total",
        "passed",
        "blocked",
        "remaining"
      ],
      "properties": {
        "total": {
          "type": "number"
        },
        "passed": {
          "type": "number"
        },
        "blocked": {
          "type": "number"
        },
        "remaining": {
          "type": "number"
        }
      }
    },
    "CrewSessionRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "crewName",
        "memberName",
        "startedAt"
      ],
      "properties": {
        "crewName": {
          "type": "string"
        },
        "memberName": {
          "type": "string"
        },
        "phase": {
          "anyOf": [
            {
              "enum": [
                "brainstorm",
                "plan",
                "impl"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "startedAt": {
          "type": "string"
        },
        "sessionId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "transcriptPath": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "endedAt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "outcome": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "summary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "_isExplicit": {
          "type": "boolean"
        },
        "cwd": {
          "type": "string"
        }
      }
    },
    "CrewSessionsByStage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "brainstorming": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CrewSessionRef"
          }
        },
        "brainstorm-ready": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CrewSessionRef"
          }
        },
        "planning": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CrewSessionRef"
          }
        },
        "plan-ready": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CrewSessionRef"
          }
        },
        "implementing": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CrewSessionRef"
          }
        },
        "reviewing": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CrewSessionRef"
          }
        },
        "review-fix": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CrewSessionRef"
          }
        },
        "replan-pending": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CrewSessionRef"
          }
        },
        "shipped": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CrewSessionRef"
          }
        },
        "blocked": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CrewSessionRef"
          }
        }
      }
    },
    "RalphPipelineState": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "stage"
      ],
      "properties": {
        "stage": {
          "enum": [
            "brainstorming",
            "brainstorm-ready",
            "planning",
            "plan-ready",
            "implementing",
            "reviewing",
            "review-fix",
            "replan-pending",
            "shipped",
            "blocked"
          ]
        },
        "regressionReason": {
          "type": "string"
        },
        "branchName": {
          "type": "string"
        },
        "deferredQuestionsCount": {
          "type": "number"
        },
        "deferredQuestionsPreview": {
          "type": "string"
        },
        "mergeCommit": {
          "type": "string"
        },
        "prUrl": {
          "type": "string"
        },
        "storyDoctorInterventions": {
          "type": "number"
        },
        "entryPath": {
          "enum": [
            "brainstorm-first",
            "plan-direct",
            "manual-plan"
          ]
        },
        "artifacts": {
          "$ref": "#/$defs/RalphArtifacts"
        },
        "jobSlug": {
          "type": "string"
        },
        "groupSlug": {
          "type": "string"
        },
        "isParallel": {
          "type": "boolean"
        },
        "matchSource": {
          "enum": [
            "overviewTaskId",
            "override",
            "slug-default"
          ]
        },
        "storyCompletion": {
          "$ref": "#/$defs/StoryCompletion"
        },
        "reviewOpenCount": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "hasPrdWorthy": {
          "type": "boolean"
        },
        "terminalReason": {
          "enum": [
            "complete",
            "replan",
            "blocked"
          ]
        },
        "lastUpdatedAt": {
          "type": "string"
        },
        "crewSessions": {
          "$ref": "#/$defs/CrewSessionsByStage"
        }
      }
    },
    "SnapshotTask": {
      "allOf": [
        {
          "$ref": "#/$defs/OverviewTask"
        },
        {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "ralph": {
              "$ref": "#/$defs/RalphPipelineState"
            },
            "unblockCandidate": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "RunRecord": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string"
        },
        "taskId": {
          "type": "string"
        },
        "ranAt": {
          "type": "string"
        },
        "outcome": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "commits": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "Recommendation": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "taskId",
        "score"
      ],
      "properties": {
        "taskId": {
          "type": "string"
        },
        "score": {
          "type": "number"
        },
        "stage": {
          "$ref": "#/$defs/RalphPipelineState/properties/stage"
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unblockCandidate": {
          "type": "boolean"
        }
      }
    },
    "DependencyGraph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodes",
        "edges"
      ],
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "task",
                  "story"
                ]
              },
              "taskId": {
                "type": "string"
              },
              "storyId": {
                "type": "string"
              },
              "stage": {
                "$ref": "#/$defs/RalphPipelineState/properties/stage"
              }
            }
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "from",
              "to"
            ],
            "properties": {
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "blocks",
                  "depends-on-story",
                  "spawn",
                  "depends-on-task"
                ]
              }
            }
          }
        }
      }
    },
    "UnmatchedEntry": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "kind",
        "slug",
        "reason"
      ],
      "properties": {
        "kind": {
          "type": "string"
        },
        "slug": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      }
    }
  }
}
