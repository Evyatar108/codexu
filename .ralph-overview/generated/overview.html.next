ters-popover .filter-group:last-child{margin-bottom:0}.toolbar-filters-popover .filter-group h4{text-transform:uppercase;letter-spacing:.06em;color:var(--muted);margin:0 0 6px;font-size:10px;font-weight:700}.toolbar-filters-popover .filter-chips{box-shadow:none;background:0 0;border:none;flex-wrap:wrap;gap:4px;margin:0;padding:0;display:flex}button.cmd-select{border:1px solid var(--border);background:var(--card);color:#0000;vertical-align:middle;border-radius:3px;justify-content:center;align-items:center;width:16px;height:16px;padding:0;font-size:11px;line-height:1;display:inline-flex}button.cmd-select[data-state=checked],button.cmd-select[data-state=indeterminate]{background:var(--accent);border-color:var(--accent);color:#fff}button.cmd-select:disabled{opacity:.45;cursor:not-allowed}button.cmd-select:focus-visible{outline:2px solid var(--accent);outline-offset:1px}.cmd-select-indicator{justify-content:center;align-items:center;display:inline-flex}.sticky-frame{z-index:10;background:var(--card);border:1px solid var(--border);-webkit-backdrop-filter:blur(4px);backdrop-filter:blur(4px);border-radius:6px;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:8px 18px;margin:-8px -8px 12px;padding:8px 12px;display:flex;position:sticky;top:0}.sticky-metrics{flex-wrap:wrap;align-items:center;gap:6px;display:flex}.sticky-metric{border:1px solid var(--border);background:var(--bg);color:var(--fg);cursor:pointer;border-radius:999px;align-items:baseline;gap:4px;padding:3px 8px;font-size:12px;display:inline-flex}.sticky-metric .sticky-metric-count{font-weight:700}.sticky-metric .sticky-metric-label{color:var(--muted)}.sticky-metric.active{border-color:var(--accent);color:var(--accent);background:#7aa2f72e}.sticky-metric-shipped{cursor:default}.sticky-metric:focus-visible{outline:2px solid var(--accent);outline-offset:1px}.sticky-toc{flex-wrap:wrap;gap:4px;display:flex}.sticky-toc-link{color:var(--muted);border:1px solid #0000;border-radius:4px;align-items:center;padding:3px 8px;font-size:12px;text-decoration:none;display:inline-flex}.sticky-toc-link:hover{background:var(--bg);color:var(--fg);border-color:var(--border)}.sticky-toc-link:focus-visible{outline:2px solid var(--accent);outline-offset:1px}details.cmd-bucket{border:1px solid var(--border);background:0 0;border-radius:6px;margin:6px 0}details.cmd-bucket>summary.cmd-bucket-summary{cursor:pointer;color:var(--fg);background:var(--card);border-radius:6px;align-items:center;gap:10px;padding:6px 10px;font-size:12px;font-weight:600;list-style:none;display:flex}details.cmd-bucket>summary.cmd-bucket-summary::-webkit-details-marker{display:none}details.cmd-bucket[open]>summary.cmd-bucket-summary{border-bottom:1px solid var(--border);border-bottom-right-radius:0;border-bottom-left-radius:0}details.cmd-bucket>summary.cmd-bucket-summary:focus-visible{outline:2px solid var(--accent);outline-offset:1px}.cmd-bucket-label{color:var(--muted);flex:1}.cmd-bucket-body{padding:4px 0}button.bucket-summary-checkbox{border:1px solid var(--border);background:var(--card);color:#0000;cursor:pointer;border-radius:3px;justify-content:center;align-items:center;width:16px;height:16px;padding:0;font-size:11px;line-height:1;display:inline-flex}button.bucket-summary-checkbox[data-state=checked],button.bucket-summary-checkbox[data-state=indeterminate]{background:var(--accent);border-color:var(--accent);color:#fff}button.bucket-summary-checkbox:disabled{opacity:.45;cursor:not-allowed}button.bucket-summary-checkbox:focus-visible{outline:2px solid var(--accent);outline-offset:1px}.bucket-summary-checkbox-indicator{justify-content:center;align-items:center;display:inline-flex}.left-rail{flex-direction:column;gap:14px;font-size:12px;display:flex}.left-rail-section{background:var(--card);border:1px solid var(--border);border-radius:8px;flex-direction:column;gap:6px;padding:10px 12px;display:flex}.left-rail-today{border-left:4px solid var(--accent)}.left-rail-whatsnew{border-left:4px solid var(--info)}.left-rail-shipped{border-left:4px solid var(--ok)}.left-rail-periodic{border-left:4px solid var(--purple)}.left-rail-title{color:var(--fg);text-transform:uppercase;letter-spacing:.04em;justify-content:space-between;align-items:center;gap:6px;margin:0;font-size:12px;font-weight:700;display:flex}.left-rail-title-meta{color:var(--muted);text-transform:none;letter-spacing:0;font-weight:400}.left-rail-sub{color:var(--muted);font-size:11px}.left-rail-row{flex-direction:column;gap:4px;display:flex}.left-rail-row .today-label{font-size:10px}.left-rail-row .today-chips{gap:4px}.left-rail-chips{flex-wrap:wrap;gap:4px;display:flex}.left-rail-section .wn-dismiss{border:1px solid var(--border);color:var(--muted);cursor:pointer;background:0 0;border-radius:4px;padding:2px 8px;font-family:inherit;font-size:10px}.left-rail-section .wn-dismiss:hover{color:var(--fg);border-color:var(--accent)}.left-rail-legend .legend{flex-direction:column;align-items:flex-start;gap:4px;margin:0}.left-rail-drawer-trigger{background:var(--card);border:1px solid var(--border);color:var(--fg);font:inherit;cursor:pointer;border-radius:6px;align-items:center;gap:6px;margin:0 0 12px;padding:8px 14px;font-size:13px;display:inline-flex}.left-rail-drawer-trigger:hover,.left-rail-drawer-trigger:focus-visible{border-color:var(--accent)}.left-rail-drawer-backdrop{z-index:90;background:#00000080;position:fixed;inset:0}.left-rail-drawer{background:var(--bg);border-right:1px solid var(--border);z-index:100;flex-direction:column;width:min(320px,90vw);padding:12px;display:flex;position:fixed;top:0;bottom:0;left:0;overflow-y:auto;box-shadow:2px 0 12px #0000004d}.left-rail-drawer-header{border-bottom:1px solid var(--border);justify-content:space-between;align-items:center;margin-bottom:10px;padding-bottom:8px;display:flex}.left-rail-drawer-title{font-size:13px;font-weight:600}.left-rail-drawer-close{border:1px solid var(--border);color:var(--muted);cursor:pointer;font:inherit;background:0 0;border-radius:4px;padding:2px 8px;font-size:12px;line-height:1}.left-rail-drawer-close:hover,.left-rail-drawer-close:focus-visible{color:var(--fg);border-color:var(--accent)}.left-rail-drawer-body{flex-direction:column;gap:14px;display:flex}
