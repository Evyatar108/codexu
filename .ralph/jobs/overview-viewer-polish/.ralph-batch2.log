+export function countVisibleTasksByOrderBucket(tasks: OverviewTask[], visibleTaskIds?: Set<string>): Record<OrderBucket, number> {
+    const counts: Record<OrderBucket, number> = {
+        brainstorm: 0,
+        inprogress: 0,
+        ready: 0,
+        shipped: 0,
+        closed: 0,
+    }
+
