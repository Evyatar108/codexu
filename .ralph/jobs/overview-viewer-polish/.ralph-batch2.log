+        if (visibleTaskIds && !visibleTaskIds.has(task.id)) return
+        const bucket = orderBucketForTask(task)
+        if (bucket && bucket in counts) counts[bucket as OrderBucket] += 1
+    })
+
+    return counts
+}
 
