  .chip:hover { background: var(--accent); color: white; border-color: var(--accent); }
  .chip-ready { border-color: rgba(122,162,247,0.45); }
  .chip-inprogress { border-color: rgba(224,175,104,0.55); background: rgba(224,175,104,0.12); }
  .strip-count { margin-left: auto; font-size: 11px; color: var(--muted); }

