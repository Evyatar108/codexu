+
+    win.location.hash = `cmd-${taskId}`
+    const target = win.document?.getElementById(`cmd-${taskId}`)
+    target?.scrollIntoView?.({ block: 'center', behavior: 'smooth' })
+    if (target) flashCommandElement(target, win)
+}

