+                            selected={selectedTaskIds.has(task.id)}
+                            open={isExpanded(task.id)}
+                            onActivateWorkstream={onActivateWorkstream}
+                            onOpenChange={setTaskExpanded}
+                            onSelectTask={onSelectTask}
+                            query={query}
+                        />
+                    ))}
+                </div>
+            </section>
+        </details>
+    )
+}
