+import { useState } from 'react'
+import { cleanup, render, screen, waitFor, within } from '@testing-library/react'
+import userEvent from '@testing-library/user-event'
+import { afterEach, describe, expect, it } from 'vitest'
+
+import { App } from '../../App'
+import { FilterChips } from '../../components/Toolbar'
+import { createEmptyFilters } from '../../utils/filters'
+import type { OverviewData } from '../../types'
+
+const overviewData: OverviewData = {
+    generatedAt: '2026-05-01T00:00:00Z',
+    generatedFromCommit: 'abc1234',
+    tasks: [
+        {
+            id: 'perf-WS2',
+            scope: 'codexu',
+            phase: 'plan-ready',
+            status: 'ok',
+            lastTouchedAt: '2026-05-01T00:00:00Z',
+            kanbanCards: [],
+            command: {
+                name: 'perf-WS2',
+                descriptionHtml: 'Performance workstream fixture',
+                warnings: [],
+                planPrompt: 'echo perf',
+            },
+        },
+    ],
+    effort: { 'perf-WS2': 1 },
+    phaseTree: [],
+    sizeBucket: { 'perf-WS2': 'small' },
+    workstream: { 'perf-WS2': 'perf' },
+}
+
+function renderApp() {
+    window.OVERVIEW_DATA = overviewData
+    return render(<App />)
+}
+
+describe('filter popover', () => {
+    afterEach(() => {
+        cleanup()
+        window.localStorage.clear()
+    })
+
+    it('opens from a workstream pill and marks the matching chip on', async () => {
+        const user = userEvent.setup()
+        renderApp()
+
+        await user.click(screen.getByRole('link', { name: 'Filter to Performance workstream (size: small)' }))
+
+        const popover = await screen.findByRole('dialog')
+        expect(screen.getByRole('button', { name: 'Filter' }).getAttribute('data-state')).toBe('open')
+        expect(within(popover).getByRole('button', { name: 'Performance' }).getAttribute('data-state')).toBe('on')
+    })
+
+    it('closes on Escape, restores focus to the trigger, and dismisses on outside click', async () => {
+        const user = userEvent.setup()
+        function Harness() {
+            const filters = createEmptyFilters()
+            const [open, setOpen] = useState(false)
+            return (
+                <>
+                    <FilterChips activeFilters={filters} open={open} onOpenChange={setOpen} onToggle={() => undefined} />
+                    <button type="button">Outside</button>
+                </>
+            )
+        }
+
+        render(<Harness />)
+        const trigger = screen.getByRole('button', { name: 'Filter' })
+        await user.click(trigger)
+
+        expect(await screen.findByRole('dialog')).toBeTruthy()
+        await user.keyboard('{Escape}')
+
+        await waitFor(() => expect(screen.queryByRole('dialog')).toBeNull())
+        expect(document.activeElement).toBe(trigger)
+
+        await user.click(trigger)
+        expect(await screen.findByRole('dialog')).toBeTruthy()
+        await user.click(screen.getByRole('button', { name: 'Outside' }))
+
+        await waitFor(() => expect(screen.queryByRole('dialog')).toBeNull())
+    })
+
+    it('tabs through chips and shift-tabs back within the popover content', async () => {
+        const user = userEvent.setup()
+        renderApp()
+
+        await user.click(screen.getByRole('button', { name: 'Filter' }))
+        const popover = await screen.findByRole('dialog')
+        const ready = within(popover).getByRole('button', { name: '⬜ ready' })
+        const inProgress = within(popover).getByRole('button', { name: '🟡 in progress' })
+
+        expect(document.activeElement).toBe(ready)
+        await user.tab()
+        expect(document.activeElement).toBe(inProgress)
+        await user.tab({ shift: true })
+        expect(document.activeElement).toBe(ready)
+    })
+
+    it('keeps expand-all and collapse-all wired to the filter surface', async () => {
+        const user = userEvent.setup()
+        renderApp()
+
+        const trigger = screen.getByRole('button', { name: 'Filter' })
+        await user.keyboard('e')
+        expect(trigger.getAttribute('data-state')).toBe('open')
+        expect(await screen.findByRole('dialog')).toBeTruthy()
+
+        await user.keyboard('c')
+        await waitFor(() => expect(screen.queryByRole('dialog')).toBeNull())
+        expect(trigger.getAttribute('data-state')).toBe('closed')
+    })
+})
