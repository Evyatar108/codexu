+export function FilterChips({ activeFilters, onOpenChange, onToggle, open }: { activeFilters: ActiveFilters; onOpenChange: (open: boolean) => void; onToggle: (axis: FilterAxis, value: string) => void; open: boolean }) {
+    const syncGroupValues = (axis: FilterAxis, values: string[]) => {
+        const nextValues = new Set(values)
+        for (const value of activeFilters[axis]) {
