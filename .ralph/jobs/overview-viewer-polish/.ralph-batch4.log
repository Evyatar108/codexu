async function transformWithOxc(code, filename, options, inMap, config, watcher) {
	let lang = options?.lang;
	if (!lang) {
		const ext = path.extname(validExtensionRE.test(filename) ? filename : cleanUrl(filename)).slice(1);
		if (ext === "cjs" || ext === "mjs") lang = "js";
		else if (ext === "cts" || ext === "mts") lang = "ts";
		else lang = ext;
	}
	const result = transformSync(filename, code, {
		sourcemap: true,
		...options,
		inputMap: inMap,
		lang
	}, getTSConfigResolutionCache(config)

