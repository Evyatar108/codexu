+export function FilterChips({ activeFilters, onOpenChange, onToggle, open }: { activeFilters: ActiveFilters; onOpenChange: (open: boolean) => void; onToggle: (axis: FilterAxis, value: string) => void; open: boolean }) {
+    const syncGroupValues = (axis: FilterAxis, values: string[]) => {
+        const nextValues = new Set(values)
+        for (const value of activeFilters[axis]) {
+            if (!nextValues.has(value)) onToggle(axis, value)
+        }
+        for (const value of nextValues) {
+            if (!activeFilters[axis].has(value)) onToggle(axis, value)
+        }
+    }
+
+    return (
+        <Popover.Root open={open} onOpenChange={onOpenChange}>
+            <span className="toolbar-filters">
+                <Popover.Trigger className="toolbar-filter-trigger" type="button">
+                    Filter
+                </Popover.Trigger>
+            </span>
+            <Popover.Portal>
+                <Popover.Content className="filter-popover" align="end" sideOffset={6}>
+                    {FILTER_GROUPS.map((group) => (
+                        <div key={group.axis} className="filter-group">
+                            <h4>{group.title}</h4>
+                            <ToggleGroup.Root className="filter-chips" data-filter-axis={group.axis} aria-label={`Filter by ${group.axis}`} type="multiple" rovingFocus={false} value={[...activeFilters[group.axis]]} onValueChange={(values) => syncGroupValues(group.axis, values)}>
+                                {group.chips.map((chip) => (
+                                    <ToggleGroup.Item key={chip.value} className="filter-chip" data-filter-value={chip.value} value={chip.value}>
+                                        {chip.label}
+                                    </ToggleGroup.Item>
+                                ))}
+                            </ToggleGroup.Root>
+                        </div>
+                    ))}
+                </Popover.Content>
+            </Popover.Portal>
+        </Popover.Root>
+    )
+}
 
