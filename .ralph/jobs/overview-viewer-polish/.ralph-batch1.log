Playwright is not installed in this worktree, so I’ll use a dev-server HTTP smoke check and record browser console/file double-click verification as unavailable rather than claiming a browser pass.
exec
"C:\\Program Files\\Git\\bin\\bash.exe" -lc 'set -e
mkdir -p .test-output
: > .test-output/overview-viewer.dev.log
if curl -fsS http://127.0.0.1:5173/overview.html >/dev/null 2>&1; then
  echo "port 5173 already serving overview"
  curl -fsS http://127.0.0.1:5173/overview.html > .test-output/overview-viewer.dev.html
  curl -fsS http://127.0.0.1:5173/overview-data.js > /dev/null
else
  pnpm overview > .test-output/overview-viewer.dev.log 2>&1 &
  PID=$!
  ok=0
  for i in $(seq 1 30); do
    if curl -fsS http://127.0.0.1:5173/overview.html > .test-output/overview-viewer.dev.html 2>/dev/null; then
      ok=1
      break
    fi
    sleep 1
  done
  curl -fsS http://127.0.0.1:5173/overview-data.js > /dev/null
  kill $PID >/dev/null 2>&1 || true
  wait $PID >/dev/null 2>&1 || true
  if [ "$ok" != "1" ]; then
    echo "dev server did not respond" >&2
    tail -40 .test-output/overview-viewer.dev.log >&2
    exit 1
  fi
fi
if grep -q '"'<div id=\"root\"></div>' .test-output/overview-viewer.dev.html && grep -q './overview-data.js' .test-output/overview-viewer.dev.html; then
  echo \"dev server smoke PASS: overview.html and overview-data.js served\"
else
  echo \"dev server smoke FAIL: expected root/data script missing\" >&2
  exit 1
fi
