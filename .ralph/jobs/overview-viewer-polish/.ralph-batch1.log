  /* Status sort order — brainstorm first, then shipped, closed, inprogress,
     ready (in that bucket order). WITHIN each bucket, rows with
     data-task-status="blocked" or "paused" fall to the tail (+1 order).
     This is a deliberate UX deviation from the 9f81c1f8 baseline, which
     ordered by phase only and interleaved blocked/paused rows with their
     non-blocked peers — see tools/overview-viewer/README.md. Both shipped
     and closed share the b-closed badge class; the order bucket tells them
     apart by phase. Fallback 99 keeps unclassified rows out of the way. */
  details.cmd { order: 99; }
  details.cmd[data-cmd-status="brainstorm"] { order: 0; }
  details.cmd[data-cmd-status="brainstorm"][data-task-status="blocked"],
  details.cmd[data-cmd-status="brainstorm"][data-task-status="paused"] { order: 1; }
  details.cmd[data-cmd-status="shipped"]  { order: 2; }
  details.cmd[data-cmd-status="shipped"][data-task-status="blocked"],
  details.cmd[data-cmd-status="shipped"][data-task-status="paused"] { order: 3; }
  details.cmd[data-cmd-status="closed"]   { order: 4; }
  details.cmd[data-cmd-status="closed"][data-task-status="blocked"],
  details.cmd[data-cmd-status="closed"][data-task-status="paused"] { order: 5; }
  details.cmd[data-cmd-status="inprogress"] { order: 6; }
  details.cmd[data-cmd-status="inprogress"][data-task-status="blocked"],
  details.cmd[data-cmd-status="inprogress"][data-task-status="paused"] { order: 7; }
  details.cmd[data-cmd-status="ready"]    { order: 8; }
  details.cmd[data-cmd-status="ready"][data-task-status="blocked"],
