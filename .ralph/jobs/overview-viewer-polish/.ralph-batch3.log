  .cmd-badge.b-plan-ready { background: rgba(122,162,247,0.18); color: var(--accent); }
  .cmd-badge.b-plan-in-progress { background: rgba(224,175,104,0.22); color: var(--warn); }
  .cmd-badge.b-plan-review { background: rgba(255,158,100,0.20); color: #ff9e64; }
  .cmd-badge.b-impl-ready { background: rgba(125,207,255,0.16); color: var(--info); }
  .cmd-badge.b-impl-in-progress { background: rgba(224,175,104,0.30); color: var(--warn); }
  .cmd-badge.b-shipped { background: rgba(158,206,106,0.18); color: var(--ok); }
  [data-task-phase='closed'] .cmd-badge.b-closed { background: rgba(86,95,137,0.25); color: var(--done); }
  .cmd-status-mod {
    display: inline-block;
    font-size: 10px;
    padding: 1px 6px;
    border-radius: 3px;
    font-weight: 600;
    white-space: nowrap;
    background: rgba(86,95,137,0.22);
    color: var(--done);
    border: 1px solid rgba(86,95,137,0.4);
  }
  .cmd-status-mod.blocked { background: rgba(86,95,137,0.25); color: var(--done); }
  .cmd-status-mod.paused { background: rgba(86,95,137,0.18); color: var(--done); }
  /* Task-scope chips — visible markers driven by data-task-scope on
     <details class="cmd">. Attribute is a `|`-delimited list, e.g.
     "codexu", "codex", "codex|codexu", "bookkeeping|codexu". Each
     declared value renders its own chip in the summary. Chips also
     gate the copy-time preamble injection (see JS). */
  .task-scope-chip {
    font-size: 10px;
    padding: 1px 6px;
    border-radius: 3px;
    font-weight: 600;
    white-space: nowrap;
    border: 1px solid transparent;
  }
  .task-scope-chip.bookkeeping {
    background: rgba(224,175,104,0.18);
    color: var(--warn);
    border-color: rgba(224,175,104,0.4);
  }
  .task-scope-chip.codexu {
    background: rgba(122,162,247,0.14);
    color: var(--accent);
    border-color: rgba(122,162,247,0.35);
  }
  .task-scope-chip.codex {
    background: rgba(247,118,142,0.14);
    color: #f7768e;
    border-color: rgba(247,118,142,0.35);
  }
  .task-scope-chip.missing {
    background: rgba(247,118,142,0.2);
    color: #f7768e;
    border-color: rgba(247,118,142,0.6);
  }
  .cmd-desc { color: var(--muted); font-size: 12px; flex: 1; }
  .cmd-body {
    position: relative;
  }
  .cmd-body-inner {
    padding-top: 10px;
  }
  @supports (interpolate-size: allow-keywords) {
    .cmd-body {
      display: grid;
      grid-template-rows: 0fr;
      interpolate-size: allow-keywords;
      transition: grid-template-rows 0.3s ease-out;
    }
    .cmd[open] > .cmd-body { grid-template-rows: 1fr; }
    .cmd-body-inner {
      min-height: 0;
      overflow: hidden;
    }
  }

