  }
  .copy-name-btn:hover { color: var(--fg); border-color: var(--accent); }
  .copy-name-btn.copied { background: var(--ok); color: white; border-color: var(--ok); }
  .cmd-warn {
    background: rgba(224,175,104,0.10);
    border-left: 3px solid var(--warn);
    padding: 6px 10px;
    margin-top: 8px;
    font-size: 12px;
    color: var(--fg);
  }
  .cmd-warn.blocked { background: rgba(86,95,137,0.12); border-left-color: var(--done); }
  .cmd-warn.closed { background: rgba(158,206,106,0.10); border-left-color: var(--ok); }

