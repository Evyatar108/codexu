+                    ↑
+                </QuickNavButton>
+            ) : null}
+            {firstChildId ? (
+                <QuickNavButton ariaLabel={`Jump to first child ${firstChildId} of ${task.id}`} title={`Jump to first child ${firstChildId}`} onNavigate={() => navigateToCommand(firstChildId, onOpenChange)}>
+                    ↓{childIds.length}
+                </QuickNavButton>
+            ) : null}
+            {hasKanbanCard ? (
