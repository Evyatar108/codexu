  .ready-strip .capacity-line {
    flex-basis: 100%;
    font-size: 11px;
    color: var(--muted);
    margin-top: 4px;
  }

  /* BOOX / coarse-pointer / narrow-viewport tweaks
     E-ink (BOOX) quantizes muted greys to pure white. We boost contrast,
     enlarge tap targets, and drop subtle decorations. */
  @media (max-width: 900px), (pointer: coarse) {
    body { font-size: 15px; }
    .sub, .cmd-desc, .card-meta, .footnote, .section-counts, .strip-count, .kbd-hint {
