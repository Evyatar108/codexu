+            aria-label={ariaLabel}
+            title={title}
+            onClick={async (event) => {
+                stopToggle(event)
+                if (await copyTextWithToast({ label, text, showToast })) markCopied()
+            }}
+        >
+            {children}
+        </button>
+    )
+}
+
