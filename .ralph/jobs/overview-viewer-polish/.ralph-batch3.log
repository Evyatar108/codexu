      min-height: 40px;
    }
    .cmd-actions { gap: 4px; }
    .cmd-select { width: 22px; height: 22px; cursor: pointer; }
    .filter-chip { padding: 8px 14px; font-size: 13px; min-height: 36px; }
    .chip { padding: 6px 12px; font-size: 13px; }
    #search { padding: 10px 14px; font-size: 14px; min-height: 40px; }
    .kanban { grid-template-columns: 1fr; }
    .phase-grid { grid-template-columns: 1fr; }
    /* Higher-contrast borders for e-ink readability */
    .card, .cmd, .phase, .kbd-help, .ready-strip {
      border-color: var(--fg);
    }
    /* Drop the area-color left border subtlety — e-ink crushes it; keep solid full border for visibility */
    .card[class*="area-bdr-"] { border-left-width: 4px; }
    /* Make section-head chevron larger */
    details.section > summary { font-size: 18px; padding: 10px 0; }
    details.section > summary::before { font-size: 14px; min-width: 16px; }
    details.cmd > summary { font-size: 14px; padding: 4px 0; }
    /* Banner inline buttons easier to tap */
    .whatsnew-banner { padding: 16px; }
    .whatsnew-banner .wn-dismiss { padding: 10px 16px; }
  }

  /* Collapsible top-level sections — "Spine" concept.
     Each section carries a unique --sec hue assigned by its sec-* class.
     A 4px left stripe in that hue gives instant scannable identity; the
    max-height: 360px;
    overflow-y: auto;
    margin: 0;
    tab-size: 2;
  }
  /* Action-button cluster — lives inside the cmd <summary>, pushed to
     the right end by the .cmd-desc { flex: 1 } sibling. Visible even
     when the row is collapsed (the whole point of being in summary).
     row-reverse so the first-appended child (the static Copy Command)
     sits rightmost; later-appended buttons stack to its left with a
     consistent 6px gap. `order: 1` forces .cmd-actions to render
     after every other summary child regardless of DOM insertion order
     (several injectors append to summary after this one). */
  .cmd-actions {
    display: flex;
    flex-direction: row-reverse;
    gap: 6px;
    margin-left: auto;
    order: 1;
  }
  .copy-btn {
    background: var(--card-hover);
    color: var(--fg);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 4px 12px;
    font-size: 11px;
    font-family: inherit;
    cursor: pointer;
    transition: background 0.1s, color 0.1s;
  }
  .copy-btn:hover { background: var(--accent); color: white; border-color: var(--accent); }
  .copy-btn.copied { background: var(--ok); color: white; border-color: var(--ok); }
  .copy-name-btn {
    background: var(--card-hover);
