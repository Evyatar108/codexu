diff --git a/tools/overview-viewer/src/__tests__/copyToast.test.tsx b/tools/overview-viewer/src/__tests__/copyToast.test.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..2921b0eac873bdafb3efaccee4f4f89c8d5f9646
