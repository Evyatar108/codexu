   360	    private appendToReplayBuffer(payload: UpdatePayload, recipientFilter: RecipientFilter): void {
   361	        replayBuffer.push({ payload, recipientFilter, createdAt: Date.now() });
   362	        if (replayBuffer.length > replayBufferLimit) {
