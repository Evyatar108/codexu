   368	    // Keep this mapping in lockstep with doesFilterMatchConnection.
   369	    private getRoomsForFilter(userId: string, filter: RecipientFilter): string[] {
   370	        switch (filter.type) {
   371	            case 'all-user-authenticated-connections':
   372	                return [`user:${userId}`];
   373	            case 'user-scoped-only':
   374	                return [`user:${userId}:user-scoped`];
   375	            case 'all-interested-in-session':
   376	                // Union: session watchers + user-scoped (Socket.IO deduplicates)
   377	                return [`user:${userId}:session:${filter.sessionId}`, `user:${userId}:user-scoped`];
   378	            case 'machine-scoped-only':
   379	                // Union: specific machine + user-scoped
   380	                return [`user:${userId}:machine:${filter.machineId}`, `user:${userId}:user-scoped`];
   381	        }
   382	    }
   383	
   384	    // Keep this mapping in lockstep with getRoomsForFilter.
   385	    private doesFilterMatchConnection(filter: RecipientFilter, connection: ClientConnection): boolean {
   386	        switch (filter.type) {
   387	            case 'all-user-authenticated-connections':
   388	                return true;
   389	            case 'user-scoped-only':
   390	                return connection.connectionType === 'user-scoped';
   391	            case 'all-interested-in-session':
   392	                return connection.connectionType === 'user-scoped'
   393	                    || (connection.connectionType === 'session-scoped' && connection.sessionId === filter.sessionId);
   394	            case 'machine-scoped-only':
   395	                return connection.connectionType === 'user-scoped'
   396	                    || (connection.connectionType === 'machine-scoped' && connection.machineId === filter.machineId);
   397	        }
   398	    }
