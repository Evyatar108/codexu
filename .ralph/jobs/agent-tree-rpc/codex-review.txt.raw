   415	
   416	        if (params.sourceId === this.id && params.skipSenderConnection) {
   417	            params.skipSenderConnection.socket.broadcast.to(rooms).emit(params.eventName, params.payload);
   418	        } else {
   419	            this.io.to(rooms).emit(params.eventName, params.payload);
   420	        }
   421	    }
   422	}
   423	
   424	export function createEventRouter(io: Server, bus: EventRouterBus = sharedEventRouterBus): EventRouter {
   425	    return new EventRouterSink(io, bus);
   426	}
   427	
   428	export function __resetEventRouterReplayStateForTests(): void {
   429	    replayBuffer.length = 0;
   430	    currentSeq = 0;
   431	}
   432	
   433	export function __getEventRouterReplayStateForTests(): { replayBuffer: BufferedUpdate[]; currentSeq: number } {
   434	    return { replayBuffer: [...replayBuffer], currentSeq };
   435	}
   436	
   437	export function __forceEventRouterReplayStateForTests(nextState: { replayBuffer?: BufferedUpdate[]; currentSeq?: number }): void {
   438	    replayBuffer.length = 0;
   439	    replayBuffer.push(...(nextState.replayBuffer ?? []));
   440	    currentSeq = nextState.currentSeq ?? 0;
   441	}
   442	
   443	// === EVENT BUILDER FUNCTIONS ===
   444	
   445	export function buildNewSessionUpdate(session: {
   446	    id: string;
   447	    seq: number;
   448	    metadata: string;
   449	    metadataVersion: number;
   450	    agentState: string | null;
   451	    agentStateVersion: number;
   452	    dataEncryptionKey: Uint8Array | null;
   453	    active: boolean;
   454	    lastActiveAt: Date;
   455	    createdAt: Date;

codex
### Completeness

[High] `packages/happy-cli/src/codex/codex.integration.test.ts` is not updated, and `plans/codexu-roadmap.md:190` explicitly says the real-Codex nested-child acceptance remains blocked. This misses AC4, the plan’s primary acceptance test.

[Medium] `packages/happy-wire/src/agentTree.ts:1` defines node/snapshot/delta schemas, but not the shared RPC request/response or Socket.IO payload schemas required by the plan. `packages/happy-server/sources/app/api/socket/sessionUpdateHandler.ts:11` recreates the inbound payload schema locally instead.

### Correctness

[Medium] `packages/happy-cli/src/codex/codexAppServerClient.ts:395` emits `closeAgent` events for both `item/started` and `item/completed`, and `packages/happy-cli/src/codex/agentTreeState.ts:288` removes the subtree immediately. A failed or still-pending close can incorrectly delete live nodes from the tree.

[Medium] Legacy metadata recovery likely does not work with the real Codex payload. The plan says legacy spawn-end carries `new_agent_nickname` / `new_agent_role`, but `packages/happy-cli/src/codex/agentTreeState.ts:119` only reads `agentRole`, `agent_role`, or `role`, and node creation at `packages/happy-cli/src/codex/agentTreeState.ts:245` only reads `nickname`. Real legacy events can leave role as `"agent"` and nickname as `null`.

### Quality

[Low] The generated `packages/happy-wire/dist/index.d.cts:16` and `packages/happy-wire/dist/index.d.mts:16` diffs include broad property-order churn unrelated to agent-tree. That makes the actual contract change harder to audit.

[Low] The docs mark the work delivered while also noting acceptance is blocked: `plans/codexu-roadmap.md:186` marks delivered, but `plans/codexu-roadmap.md:190` says the real-Codex nested-child acceptance remains blocked. That status is misleading for downstream work.

### Security

No issues found.

### Overall Assessment

Not ready as-is. The main bridge is present, but the primary real-Codex acceptance test is missing, and the reducer/parser can publish incorrect tree state for close-agent and real legacy metadata cases.
