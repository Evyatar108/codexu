+async fn get_machine(State(state): State<Arc<AppState>>, headers: HeaderMap, uri: Uri) -> Response {
+    if !state.app_acceptance {
+        return StatusCode::NOT_FOUND.into_response();
+    }
+    if let Err(response) = verify_get(&state, &headers, &uri) {
+        return response;
+    }
+    let now = now_ms();
+    Json(json!({
+        "machineId": MACHINE_ID,
+        "hostname": MACHINE_ID,
+        "tunnelUrl": format!("http://{BIND_ADDR}"),
+        "lastSeenAt": now
+    }))
+    .into_response()
+}
+
+async fn get_sessions(
+    State(state): State<Arc<AppState>>,
+    headers: HeaderMap,
+    uri: Uri,
+) -> Response {
+    if !state.app_acceptance {
+        return StatusCode::NOT_FOUND.into_response();
+    }
+    if let Err(response) = verify_get(&state, &headers, &uri) {
+        return response;
+    }
+    let data = state.data.lock().expect("compat data mutex poisoned");
+    let now = now_ms();
+    let seq = data
+        .messages
+        .last()
+        .map(|message| message.seq)
+        .unwrap_or_default();
+    Json(json!({
+        "sessions": [{
+            "id": SESSION_ID,
+            "tag": "compat",
+            "seq": seq,
+            "metadata": data.metadata,
+            "metadataVersion": data.metadata_version,
+            "agentState": data.agent_state,
+            "agentStateVersion": data.agent_state_version,
+            "active": data.active,
+            "activeAt": now,
+            "createdAt": now,
+            "updatedAt": now,
+            "lastMessage": data.messages.last()
+        }]
+    }))
+    .into_response()
+}
+
+async fn get_session_messages(
+    State(state): State<Arc<AppState>>,
+    AxumPath(session_id): AxumPath<String>,
+    headers: HeaderMap,
+    uri: Uri,
+) -> Response {
+    if !state.app_acceptance {
+        return StatusCode::NOT_FOUND.into_response();
+    }
+    if let Err(response) = verify_get(&state, &headers, &uri) {
+        return response;
+    }
+    if session_id != SESSION_ID {
+        return StatusCode::NOT_FOUND.into_response();
+    }
+    let after_seq = form_urlencoded::parse(uri.query().unwrap_or_default().as_bytes())
+        .find_map(|(key, value)| {
+            (key == "after_seq")
+                .then(|| value.parse::<u64>().ok())
+                .flatten()
+        })
+        .unwrap_or_default();
+    let data = state.data.lock().expect("compat data mutex poisoned");
+    let messages = data
+        .messages
+        .iter()
+        .filter(|message| message.seq > after_seq)
+        .cloned()
+        .collect::<Vec<_>>();
+    Json(json!({"messages": messages, "hasMore": false})).into_response()
+}
+
+fn verify_get(state: &AppState, headers: &HeaderMap, uri: &Uri) -> Result<(), Response> {
+    let target = uri
+        .path_and_query()
+        .map(|value| value.as_str())
+        .unwrap_or(uri.path());
+    state
+        .auth
+        .verify_paired_proof(header_value(headers, PROOF_HEADER), "GET", target, b"")
+        .map(|_| ())
+        .map_err(|error| auth_error(StatusCode::UNAUTHORIZED, error))
+}
+
+fn compat_metadata() -> String {
+    serde_json::to_string(&json!({
+        "path": "C:\\fixture",
+        "host": MACHINE_ID,
+        "machineId": MACHINE_ID,
+        "flavor": "codex"
+    }))
+    .expect("compat metadata must serialize")
+}
+
+fn plain_session_message(
+    id: &str,
+    seq: u64,
+    item_id: &str,
+    text: &str,
+    timestamp: i64,
+) -> SessionMessage {
+    let raw_record = json!({
+        "role": "session",
+        "content": {
+            "id": format!("{id}-envelope"),
+            "time": timestamp,
+            "role": "agent",
+            "turn": "compat-turn",
+            "ev": {
+                "t": "text",
+                "text": text
+            }
+        }
+    });
+    SessionMessage {
+        id: id.into(),
+        seq,
+        local_id: Some(format!("codex-origin:assistant:{item_id}")),
+        content: EncryptedLookingContent {
+            t: "encrypted".into(),
+            c: serde_json::to_string(&raw_record).expect("compat message must serialize"),
+        },
+        created_at: timestamp,
+        updated_at: timestamp,
+    }
+}
