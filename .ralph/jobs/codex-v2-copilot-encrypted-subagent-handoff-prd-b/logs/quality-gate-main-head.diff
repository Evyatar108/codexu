+    /bash scripts\/verify-core-change\.sh workspace.*mandatory T2 gate/s,
+  );
+
+  for (const relativePath of [
+    "docs/README.md",
+    "docs/workflows/install.md",
+    "docs/workflows/developer-guide.md",
+  ]) {
+    const doc = readFileSync(join(root, relativePath), "utf8");
+    assert.doesNotMatch(doc, /GitHub Packages registry alternative/);
+  }
+
+  const installGuide = readFileSync(
+    join(root, "docs/workflows/install.md"),
+    "utf8",
+  );
+  const developerGuide = readFileSync(
+    join(root, "docs/workflows/developer-guide.md"),
+    "utf8",
+  );
+  const architecture = readFileSync(
+    join(root, "docs/implementation/architecture.md"),
+    "utf8",
+  );
+  for (const doc of [installGuide, developerGuide]) {
+    assert.match(doc, /npm (?:ls|uninstall) -g @openai\/codex/);
+    assert.match(doc, /\$\(npm root -g\)\/@openai\/codex\/vendor/);
+    assert.doesNotMatch(doc, /@gim-home\/codex(?:-win32-x64)?\/vendor/);
+  }
+  assert.match(installGuide, /npm ls -g @openai\/codex/);
+  assert.match(installGuide, /npm uninstall -g @openai\/codex/);
+  assert.match(developerGuide, /npm ls -g @openai\/codex/);
+  assert.match(developerGuide, /npm uninstall -g @openai\/codex/);
+  for (const doc of [developerGuide, architecture]) {
+    for (const binary of [
+      "codex.exe",
+      "codex-core.exe",
+      "codex-windows-sandbox-setup.exe",
+      "codex-command-runner.exe",
+      "rg.exe",
+    ]) {
+      assert.match(doc, new RegExp(binary.replace(".", String.raw`\.`)));
+    }
+  }
+});
