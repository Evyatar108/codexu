+mkdir -p "$BIN" "$SCRATCH/home/.xwin/crt" "$SCRATCH/home/.xwin/sdk"
+trap 'rm -rf "$SCRATCH"' EXIT
+
+cat >"$BIN/sccache" <<'EOF'
+#!/usr/bin/env bash
+printf '%s\n' "$*" >>"$ITER_TEST_LOG"
+case "${1:-}" in
+  --show-stats)
+    printf 'Compile requests                     1\n'
+    printf 'Cache location                  Local disk: %s\n' "$ITER_TEST_ACTIVE"
+    ;;
+  --start-server|--stop-server) ;;
+esac
+EOF
+cat >"$BIN/clang-cl" <<'EOF'
+#!/usr/bin/env bash
+exit 0
+EOF
+cp "$BIN/clang-cl" "$BIN/lld-link"
+chmod +x "$BIN"/*
+
+export ITER_TEST_LOG="$LOG"
+export PATH="$BIN:/usr/bin:/bin"
+export HOME="$SCRATCH/home"
+
+variants=(
+  'D:\codex-sccache'
+  'D:\\codex-sccache'
+  'D:/codex-sccache/'
+  'd:\CODEX-SCCACHE'
+  '"D:\\codex-sccache"'
+  '"  D:\\codex-sccache  "'
+  '/d/codex-sccache'
+)
+
+for value in "${variants[@]}"; do
+  : >"$LOG"
+  export ITER_TEST_ACTIVE="$value"
+  export rUsTfLaGs='-C opt-level=1'
+  export cArGo_EnCoDeD_rUsTfLaGs='-Cdebuginfo=1'
+  export cArGo_BuIlD_rUsTfLaGs='-C target-cpu=native'
+  export cArGo_TaRgEt_X86_64_Pc_WiNdOwS_mSvC_rUsTfLaGs='-C panic=abort'
+  export cArGo_TaRgEt_AaRcH64_Pc_WiNdOwS_mSvC_rUsTfLaGs='-C panic=unwind'
+  export rUsTc_WrApPeR='alternate-canonical-wrapper'
+  export RUSTC_WORKSPACE_WRAPPER='workspace-wrapper'
+  export rustc_workspace_wrapper='case-variant-workspace-wrapper'
+  export CARGO_BUILD_RUSTC_WRAPPER=''
+  export cargo_build_rustc_wrapper='case-variant-cargo-wrapper'
+  export CARGO_BUILD_RUSTC_WORKSPACE_WRAPPER='cargo-workspace-wrapper'
+  export cargo_build_rustc_workspace_wrapper=''
+  export RUSTC=''
+  export rustc='case-variant-rustc'
+  export CARGO_BUILD_RUSTC='alternate-rustc'
+  export cargo_build_rustc=''
+  export RUSTC_BOOTSTRAP=''
+  export rustc_bootstrap='1'
+  export CARGO_BUILD_TARGET=''
+  export cargo_build_target='alternate-target'
+  export CARGO_TARGET_DIR='alternate-target-dir'
+  export cargo_target_dir=''
+  export CARGO_BUILD_TARGET_DIR=''
+  export cargo_build_target_dir='alternate-build-target-dir'
+  export cArGo_InCrEmEnTaL='1'
+  export SCCACHE_SERVER_PORT='4226'
+  export sccache_custom='lowercase'
+  export SCCACHE_EMPTY=''
+  # shellcheck disable=SC1090
+  source "$ROOT/scripts/iteration-env.sh" >/dev/null
+  while IFS= read -r alias; do
+    case "${alias^^}" in
+      RUSTFLAGS|CARGO_ENCODED_RUSTFLAGS|CARGO_BUILD_RUSTFLAGS|CARGO_TARGET_*_RUSTFLAGS|RUSTC|CARGO_BUILD_RUSTC|RUSTC_BOOTSTRAP|CARGO_BUILD_TARGET|CARGO_TARGET_DIR|CARGO_BUILD_TARGET_DIR|RUSTC_WORKSPACE_WRAPPER|CARGO_BUILD_RUSTC_WRAPPER|CARGO_BUILD_RUSTC_WORKSPACE_WRAPPER)
+        echo "forbidden iteration override leaked after source: $alias" >&2
+        exit 1
+        ;;
+      RUSTC_WRAPPER)
+        if [[ "$alias" != RUSTC_WRAPPER ]]; then
+          echo "noncanonical wrapper alias leaked after source: $alias" >&2
+          exit 1
+        fi
+        ;;
+      CARGO_INCREMENTAL)
+        if [[ "$alias" != CARGO_INCREMENTAL ]]; then
+          echo "noncanonical incremental alias leaked after source: $alias" >&2
+          exit 1
+        fi
+        ;;
+    esac
+  done < <(compgen -e)
+  while IFS= read -r alias; do
+    case "$alias" in
+      SCCACHE_DIR|SCCACHE_CACHE_SIZE) ;;
+      *)
+        echo "noncanonical sccache key leaked after source: $alias" >&2
+        exit 1
+        ;;
+    esac
+  done < <(compgen -e | grep -i '^SCCACHE_' || true)
+  test "$SCCACHE_DIR" = 'D:\codex-sccache'
+  test "$SCCACHE_CACHE_SIZE" = 50G
+  test "$RUSTC_WRAPPER" = sccache
+  test "$CARGO_INCREMENTAL" = 0
+  if grep -Eq -- '--stop-server|--start-server' "$LOG"; then
+    echo "equivalent path restarted sccache: $value" >&2
+    exit 1
+  fi
+  if declare -F _iter_normalize_windows_path >/dev/null; then
+    echo "normalization helper leaked after source" >&2
+    exit 1
+  fi
+  test "$RUSTUP_TOOLCHAIN" = stable-x86_64-pc-windows-msvc
+  test "$CC" = clang-cl
+  test "$CXX" = clang-cl
+  test "$AR" = llvm-lib
+  test "$CARGO_TARGET_X86_64_PC_WINDOWS_MSVC_LINKER" = lld-link
+done
+
+: >"$LOG"
+export ITER_TEST_ACTIVE='D:\different-cache'
+# shellcheck disable=SC1090
+source "$ROOT/scripts/iteration-env.sh" >/dev/null
+test "$(grep -c -- '--stop-server' "$LOG")" -eq 1
+test "$(grep -c -- '--start-server' "$LOG")" -eq 1
+
+echo "iteration-env sccache path tests passed"
