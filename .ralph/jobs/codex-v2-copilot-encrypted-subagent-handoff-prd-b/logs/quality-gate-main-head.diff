+    }
+    cargo = [ordered]@{
+        timingsPath = if ($timings) { $timings.FullName } else { $null }
+        artifactEvents = $artifactEvents
+        freshPackageCount = $freshPackages.Count
+        rebuiltPackageCount = $rebuiltPackages.Count
+        rebuiltPackages = @($rebuiltPackages | Sort-Object)
+    }
+    artifactWrites = [ordered]@{
+        successful = ($artifactWriteFailures.Count -eq 0)
+        errors = @($artifactWriteFailures)
+    }
+    sccache = $sccacheResult
+    freshness = $freshness
+    probe = $probeResult
+}
 
+$jsonWritten = $false
+try {
+    Write-SafeArtifactText $jsonPath ($result | ConvertTo-Json -Depth 12 -Compress)
+    $jsonWritten = $true
+} catch {
+    $artifactWriteFailures.Add("JSON artifact: $($_.Exception.Message)")
+}
+
+# Existing columns remain intact; new tier/package/budget/json fields append.
 $row = [pscustomobject]@{
-    runId          = $RunId
