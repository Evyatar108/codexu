+}
+$csvText = (($row | ConvertTo-Csv -NoTypeInformation) -join [Environment]::NewLine) + [Environment]::NewLine
+try {
+    Write-SafeArtifactText $csvPath $csvText
+} catch {
+    $artifactWriteFailures.Add("CSV artifact: $($_.Exception.Message)")
+}
+
+if ($jsonWritten) { Write-Host "[measure-build] JSON: $jsonPath" }
+if (-not ($artifactWriteFailures | Where-Object { $_ -like 'CSV artifact:*' })) {
+    Write-Host "[measure-build] CSV:  $csvPath"
+}
+if ($restoreFailure) {
+    [Console]::Error.WriteLine("Probe restoration failed: $restoreFailure")
+    exit 4
+}
+if ($sccacheFailure -and -not $cargoResult) {
+    [Console]::Error.WriteLine($sccacheFailure)
+    exit 6
+}
+if ($invocationFailure) {
