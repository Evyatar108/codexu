+The wrapper candidate records the exact submodule SHA. Require the canonical
+remote names and URLs, fetch every `main`, and prove every mirror can
+fast-forward to the same candidate before asking for approval.
+
+```bash
+cd <MAIN_REPO>
+git add external/repos/codex-patched <any wrapper-owned changed files>
+git commit -m "fix(release): <one-line summary>
+
+<body explaining the submodule release commit and wrapper gitlink update>"
+
+test "$(git branch --show-current)" = main || {
+  echo "ERROR: wrapper release candidate must be committed on main" >&2
+  exit 1
+}
+WRAPPER_CANDIDATE_SHA=$(git rev-parse HEAD)
+test "$(git rev-parse "${WRAPPER_CANDIDATE_SHA}:external/repos/codex-patched")" = "$SUBMODULE_SHA" || {
+  echo "ERROR: wrapper candidate gitlink does not equal $SUBMODULE_SHA" >&2
+  exit 1
+}
+
+test "$(git remote get-url origin)" = "https://github.com/gim-home/codex.git" || exit 1
+test "$(git remote get-url work)" = "https://github.com/evmitran_microsoft/codex.git" || exit 1
+test "$(git remote get-url personal)" = "https://github.com/Evyatar108/codex.git" || exit 1
+
+for remote in origin work personal; do
+  git fetch "$remote" main
+  REMOTE_MAIN_SHA=$(git rev-parse "refs/remotes/${remote}/main")
+  git merge-base --is-ancestor "$REMOTE_MAIN_SHA" "$WRAPPER_CANDIDATE_SHA" || {
+    echo "ERROR: $remote/main cannot fast-forward to $WRAPPER_CANDIDATE_SHA" >&2
+    exit 1
+  }
+done
+
+EXPECTED_APPROVAL="release v${NEW_VERSION} wrapper=${WRAPPER_CANDIDATE_SHA} submodule=${SUBMODULE_SHA}"
+printf 'Type exactly to approve candidate:\n%s\n> ' "$EXPECTED_APPROVAL"
+IFS= read -r APPROVAL
+test "$APPROVAL" = "$EXPECTED_APPROVAL" || {
+  echo "ERROR: exact candidate approval did not match" >&2
+  exit 1
+}
