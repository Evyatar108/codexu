+    Sort-Object LastWriteTimeUtc -Descending | Select-Object -First 1
+$budget = Get-Budget $BudgetClass $wallSeconds
 
-$afterStats = Get-SccacheStatsJson
-$afterHits   = Get-StatField $afterStats @('cache_hits','hits')
-$afterMisses = Get-StatField $afterStats @('cache_misses','misses')
-$afterStores = Get-StatField $afterStats @('cache_writes','stores')
+$sccacheResult = [ordered]@{
+    enabled = $sccacheEnabled
+    available = [bool]$sccacheDelta
+}
+if ($sccacheDelta) {
+    foreach ($name in $sccacheDelta.Keys) { $sccacheResult[$name] = $sccacheDelta[$name] }
+} else {
+    $sccacheResult.reason = if ($sccacheEnabled) { 'stats-unavailable' } else { 'disabled' }
+    if ($sccacheFailure) { $sccacheResult.error = $sccacheFailure }
+    foreach ($name in @(
+        'compileRequests', 'cacheHits', 'cacheMisses', 'cacheWrites',
+        'requestsNotCacheable', 'compileFails', 'cacheErrors',
+        'cacheReadErrors', 'cacheWriteErrors', 'cacheTimeouts'
+    )) {
+        $sccacheResult[$name] = $null
+    }
+}
+$freshness = Get-NoOpFreshness $BudgetClass $rebuiltPackages $sccacheDelta
+
+$result = [ordered]@{
