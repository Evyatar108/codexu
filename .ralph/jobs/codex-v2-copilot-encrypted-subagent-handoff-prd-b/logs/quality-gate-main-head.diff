new file mode 100755
index 0000000000..e547aa114e
--- /dev/null
+++ b/scripts/verify-core-change.sh
@@ -0,0 +1,22 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+TIER="${1:-}"
+
+case "$TIER" in
+  targeted|workspace|executable)
+    if [ "${VERIFY_CORE_CHANGE_SKIP_ITERATION_ENV:-0}" != "1" ]; then
+      # shellcheck source=iteration-env.sh
+      if [[ " $* " == *" --print-plan-json "* ]]; then
+        source "$SCRIPT_DIR/iteration-env.sh" 1>&2
+      else
+        source "$SCRIPT_DIR/iteration-env.sh"
+      fi
+    fi
+    ;;
+  publish|"")
+    ;;
+esac
+
+exec node "$SCRIPT_DIR/verify-core-change.mjs" "$@"
