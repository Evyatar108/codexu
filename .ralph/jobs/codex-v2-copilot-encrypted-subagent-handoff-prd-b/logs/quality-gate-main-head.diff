+```powershell
+$artifactDir = 'docs/implementation/build-perf-artifacts/probes'
+$repoRoot = 'external/repos/codex-patched'
+$relativePath = 'codex-rs/core/src/lib.rs'
+$filePath = Join-Path (Get-Location) (Join-Path $repoRoot $relativePath)
+$original = [IO.File]::ReadAllBytes($filePath)
+$find = [Text.Encoding]::UTF8.GetBytes('//! Root of the `codex-core` library.')
+$replace = [Text.Encoding]::UTF8.GetBytes('//! Root of the `codex-core` library. ')
+$matches = for ($i = 0; $i -le $original.Length - $find.Length; $i++) {
+  if ([Linq.Enumerable]::SequenceEqual(
+    [byte[]]$original[$i..($i + $find.Length - 1)], $find)) { $i }
+}
+if (@($matches).Count -ne 1) { throw "Expected one probe match; found $(@($matches).Count)." }
+$edited = [byte[]]::new($original.Length - $find.Length + $replace.Length)
+[Array]::Copy($original, 0, $edited, 0, $matches[0])
+[Array]::Copy($replace, 0, $edited, $matches[0], $replace.Length)
+[Array]::Copy($original, $matches[0] + $find.Length, $edited,
+  $matches[0] + $replace.Length, $original.Length - $matches[0] - $find.Length)
+$sha = { param([byte[]]$bytes)
+  ([Convert]::ToHexString([Security.Cryptography.SHA256]::HashData($bytes))).ToLowerInvariant()
+}
+$spec = [ordered]@{
+  schemaVersion = 1
+  repositoryRoot = $repoRoot
+  files = @([ordered]@{
+    path = $relativePath
+    expectedOriginalSha256 = & $sha $original
+    findBase64 = [Convert]::ToBase64String($find)
+    replaceBase64 = [Convert]::ToBase64String($replace)
+    expectedEditedSha256 = & $sha $edited
+  })
+}
+New-Item -ItemType Directory -Force $artifactDir | Out-Null
+$spec | ConvertTo-Json -Depth 4 |
+  Set-Content -Encoding utf8 (Join-Path $artifactDir 'core-lib-comment.json')
 ```
 
