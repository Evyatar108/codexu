+    sccacheStores = if ($sccacheDelta) { $sccacheDelta.cacheWrites } else { $null }
+    cargoExitCode = $exitCode
+    lto = $env:CARGO_PROFILE_RELEASE_LTO
+    codegenUnits = $env:CARGO_PROFILE_RELEASE_CODEGEN_UNITS
