new file mode 100644
index 0000000000..c442b6af4a
--- /dev/null
+++ b/scripts/verify-core-change.mjs
@@ -0,0 +1,472 @@
+#!/usr/bin/env node
+
+import { statSync } from "node:fs";
+import { dirname, join, resolve } from "node:path";
+import { fileURLToPath } from "node:url";
+import { spawnSync } from "node:child_process";
+
+const TIERS = new Set(["targeted", "workspace", "executable", "publish"]);
+const scriptDir = dirname(fileURLToPath(import.meta.url));
+const codexRoot = resolve(scriptDir, "..");
+const defaultWorkspace = join(
+  codexRoot,
+  "external",
+  "repos",
+  "codex-patched",
+  "codex-rs",
+);
+
+export class UsageError extends Error {}
+
+export function parseArgs(argv) {
+  const result = {
+    tier: argv[0] ?? "",
+    packages: [],
+    confirmSlow: false,
+    printPlanJson: false,
+  };
+  if (!TIERS.has(result.tier)) {
+    throw new UsageError(
+      "an explicit tier is required: targeted|workspace|executable|publish",
+    );
+  }
+  for (let index = 1; index < argv.length; index += 1) {
+    const arg = argv[index];
+    if (arg === "--package") {
+      const value = argv[++index];
+      if (value === undefined || value.trim() === "") {
+        throw new UsageError("--package requires a non-blank exact package name");
+      }
+      result.packages.push(value);
+    } else if (arg === "--confirm-slow") {
+      result.confirmSlow = true;
+    } else if (arg === "--print-plan-json") {
+      result.printPlanJson = true;
+    } else {
+      throw new UsageError(`unknown argument: ${arg}`);
+    }
+  }
+  if (result.tier === "targeted" && result.packages.length === 0) {
+    throw new UsageError(
+      "targeted requires --package <exact-workspace-package-name>; use workspace when package scope is uncertain",
+    );
+  }
+  if (result.tier !== "targeted" && result.packages.length > 0) {
+    throw new UsageError(`--package is not valid for tier ${result.tier}`);
+  }
+  if (
+    result.confirmSlow &&
+    result.tier !== "executable" &&
+    result.tier !== "publish"
+  ) {
+    throw new UsageError("--confirm-slow is valid only for executable or publish");
+  }
+  result.packages = [...new Set(result.packages)];
+  return result;
+}
+
+export function validateWorkspacePackages(metadata, requested) {
+  if (!metadata || !Array.isArray(metadata.packages)) {
+    throw new UsageError("cargo metadata returned an invalid packages collection");
+  }
+  const members = new Set(metadata.workspace_members ?? []);
+  return requested.map((name) => {
+    const allMatches = metadata.packages.filter((pkg) => pkg.name === name);
+    const matches = allMatches.filter((pkg) => members.has(pkg.id));
+    if (matches.length === 0) {
+      const suffix =
+        allMatches.length > 0
+          ? " (the name exists only outside workspace_members)"
+          : "";
+      throw new UsageError(`unknown workspace package: ${name}${suffix}`);
+    }
+    if (matches.length !== 1) {
+      throw new UsageError(`ambiguous workspace package name: ${name}`);
+    }
+    return name;
+  });
+}
+
+export function tierArgv(tier, packages = []) {
+  if (tier === "targeted") {
+    return [
+      "cargo",
+      "check",
+      "--timings",
+      ...packages.flatMap((name) => ["-p", name]),
+    ];
+  }
+  if (tier === "workspace") {
+    return ["cargo", "check", "--workspace", "--timings"];
+  }
+  if (tier === "executable") {
+    return [
+      "cargo",
+      "build",
+      "--release",
+      "-p",
+      "codex-cli",
+      "--bin",
+      "codex-core",
+      "-p",
+      "codex-copilot-launcher",
+      "--bin",
+      "codex",
+      "--timings",
+    ];
+  }
+  return [
+    "cargo",
+    "build",
+    "--release",
+    "--bin",
+    "codex",
+    "--bin",
+    "codex-core",
+    "--bin",
+    "codex-windows-sandbox-setup",
+    "--bin",
+    "codex-command-runner",
+    "--timings",
+  ];
+}
+
+function commandExists(command, env) {
+  const probe = process.platform === "win32" ? "where.exe" : "sh";
+  const args =
+    process.platform === "win32"
+      ? [command]
+      : ["-c", `command -v "$1" >/dev/null 2>&1`, "sh", command];
+  return spawnSync(probe, args, { env, stdio: "ignore" }).status === 0;
+}
+
+function commandIsUsable(command, env) {
+  if (!command) return false;
+  const child = spawnSync(command, ["--version"], {
+    env,
+    stdio: "ignore",
+    shell: false,
+  });
+  return !child.error && child.status === 0;
+}
+
+function cargoRustflagsAliases(env) {
+  return Object.keys(env).filter(
+    (name) =>
+      /^(?:RUSTFLAGS|CARGO_ENCODED_RUSTFLAGS|CARGO_BUILD_RUSTFLAGS)$/i.test(
+        name,
+      ) || /^CARGO_TARGET_.*_RUSTFLAGS$/i.test(name),
+  );
+}
+
+function matchingEnvKeys(env, names) {
+  const expected = new Set(names.map((name) => name.toUpperCase()));
+  return Object.keys(env).filter((name) => expected.has(name.toUpperCase()));
+}
+
+const alternateRustcWrapperAliases = [
+  "RUSTC_WORKSPACE_WRAPPER",
+  "CARGO_BUILD_RUSTC_WRAPPER",
+  "CARGO_BUILD_RUSTC_WORKSPACE_WRAPPER",
+];
+
+const compilerTargetOverrideAliases = [
+  "RUSTC",
+  "CARGO_BUILD_RUSTC",
+  "RUSTC_BOOTSTRAP",
+  "CARGO_BUILD_TARGET",
+  "CARGO_TARGET_DIR",
+  "CARGO_BUILD_TARGET_DIR",
+];
+
+const canonicalToolchainValues = {
+  RUSTUP_TOOLCHAIN: "stable-x86_64-pc-windows-msvc",
+  CC: "clang-cl",
+  CXX: "clang-cl",
+  AR: "llvm-lib",
+  CARGO_TARGET_X86_64_PC_WINDOWS_MSVC_LINKER: "lld-link",
+};
+
+function canonicalToolchainIssues(env) {
+  const issues = [];
+  for (const [name, expected] of Object.entries(canonicalToolchainValues)) {
+    if ((env[name] ?? "").toLowerCase() !== expected) {
+      issues.push(`${name} must be ${expected}`);
+    }
+  }
+  return issues;
+}
+
+function normalizeWindowsPath(value) {
+  let normalized = String(value ?? "").replaceAll("\r", "").trim();
+  if (normalized.startsWith('"') && normalized.endsWith('"')) {
+    normalized = normalized.slice(1, -1).trim();
+  }
+  normalized = normalized
+    .replaceAll("\\", "/")
+    .replace(/\/+/g, "/")
+    .replace(/^\/([a-zA-Z])\//, "$1:/")
+    .replace(/^([a-zA-Z]):\/+/, "$1:/")
+    .replace(/\/+$/, "");
+  if (/^[a-zA-Z]:$/.test(normalized)) normalized += "/";
+  return normalized.toLowerCase();
+}
+
+function canonicalSccacheIssues(env) {
+  const issues = [];
+  const canonicalNames = new Set(["SCCACHE_DIR", "SCCACHE_CACHE_SIZE"]);
+  for (const name of Object.keys(env).filter((key) => /^SCCACHE_/i.test(key))) {
+    if (!canonicalNames.has(name)) {
+      issues.push(`${name} must be unset`);
+    }
+  }
+  if (
+    normalizeWindowsPath(env.SCCACHE_DIR) !==
+    normalizeWindowsPath("D:\\codex-sccache")
+  ) {
+    issues.push("SCCACHE_DIR must be D:\\codex-sccache");
+  }
+  if (env.SCCACHE_CACHE_SIZE !== "50G") {
+    issues.push("SCCACHE_CACHE_SIZE must be 50G");
+  }
+  return issues;
+}
+
+function samePath(left, right) {
+  const normalize = (value) => {
+    const normalized = resolve(value);
+    return process.platform === "win32" ? normalized.toLowerCase() : normalized;
+  };
+  return normalize(left) === normalize(right);
+}
+
+function iterationPreflight(env) {
+  const issues = [];
+  const wrapper = env.RUSTC_WRAPPER ?? "";
+  if (!/(^|[\\/])sccache(?:\.exe)?$/i.test(wrapper)) {
+    issues.push("RUSTC_WRAPPER must resolve to sccache");
+  } else if (!commandIsUsable(wrapper, env)) {
+    issues.push(
+      `RUSTC_WRAPPER sccache is not usable (--version failed); install sccache or fix PATH/RUSTC_WRAPPER: ${wrapper}`,
+    );
+  }
+  if ((env.CARGO_PROFILE_RELEASE_LTO ?? "").toLowerCase() !== "off") {
+    issues.push("CARGO_PROFILE_RELEASE_LTO must be off");
+  }
+  if (env.CARGO_PROFILE_RELEASE_CODEGEN_UNITS !== "16") {
+    issues.push("CARGO_PROFILE_RELEASE_CODEGEN_UNITS must be 16");
+  }
+  if (env.CARGO_INCREMENTAL !== "0") {
+    issues.push("CARGO_INCREMENTAL must be 0");
+  }
+  for (const name of cargoRustflagsAliases(env)) {
+    issues.push(`${name} must be unset`);
+  }
+  for (const name of matchingEnvKeys(env, alternateRustcWrapperAliases)) {
+    issues.push(`${name} must be unset`);
+  }
+  for (const name of matchingEnvKeys(env, compilerTargetOverrideAliases)) {
+    issues.push(`${name} must be unset`);
+  }
+  issues.push(...canonicalSccacheIssues(env));
+  issues.push(...canonicalToolchainIssues(env));
+  return issues;
+}
+
+function splitExistingPaths(value) {
+  return (value ?? "")
+    .split(";")
+    .map((entry) => entry.trim())
+    .filter(Boolean);
+}
+
+function nativeFilesystemPath(value) {
+  if (
+    process.platform === "win32" &&
+    /^\/[a-zA-Z]\//.test(value ?? "")
+  ) {
+    return `${value[1]}:\\${value.slice(3).replaceAll("/", "\\")}`;
+  }
+  return value;
+}
+
+function pathHasType(value, predicate) {
+  try {
+    return predicate(statSync(nativeFilesystemPath(value)));
+  } catch {
+    return false;
+  }
+}
+
+function publishPreflight(env) {
+  const issues = [];
+  for (const name of cargoRustflagsAliases(env)) {
+    issues.push(`${name} must be unset for publish`);
+  }
+  for (const name of matchingEnvKeys(env, [
+    ...compilerTargetOverrideAliases,
+    "RUSTC_WRAPPER",
+    ...alternateRustcWrapperAliases,
+    "CARGO_INCREMENTAL",
+  ])) {
+    issues.push(`${name} must be unset for publish`);
+  }
+  for (const name of Object.keys(env).filter((key) => /^SCCACHE_/i.test(key))) {
+    issues.push(`${name} must be unset for publish`);
+  }
+  issues.push(...canonicalToolchainIssues(env));
+  if ((env.CARGO_PROFILE_RELEASE_LTO ?? "").toLowerCase() !== "thin") {
+    issues.push("CARGO_PROFILE_RELEASE_LTO must be thin");
+  }
+  if (env.CARGO_PROFILE_RELEASE_CODEGEN_UNITS !== "16") {
+    issues.push("CARGO_PROFILE_RELEASE_CODEGEN_UNITS must be 16");
+  }
+  for (const tool of ["clang-cl", "llvm-lib", "lld-link"]) {
+    if (!commandExists(tool, env)) issues.push(`${tool} is not resolvable`);
+  }
+  if (
+    !env.RUSTY_V8_ARCHIVE ||
+    !pathHasType(env.RUSTY_V8_ARCHIVE, (stats) => stats.isFile())
+  ) {
+    issues.push("RUSTY_V8_ARCHIVE must resolve to a regular file");
+  }
+  for (const name of ["LIB", "INCLUDE"]) {
+    const paths = splitExistingPaths(env[name]);
+    if (
+      paths.length === 0 ||
+      paths.some((entry) => !pathHasType(entry, (stats) => stats.isDirectory()))
+    ) {
+      issues.push(
+        `${name} must contain only semicolon-delimited paths that resolve to directories`,
+      );
+    }
+  }
+  return issues;
+}
+
+export function buildPlan(options, metadata, env = process.env) {
+  const packages =
+    options.tier === "targeted"
+      ? validateWorkspacePackages(metadata, options.packages)
+      : [];
+  const argv = tierArgv(options.tier, packages);
+  const issues = [];
+  const workspaceRoot = metadata.workspace_root ?? defaultWorkspace;
+  const targetDirectory =
+    metadata.target_directory ?? join(workspaceRoot, "target");
+  if (!commandExists("cargo", env)) issues.push("cargo is not resolvable");
+  issues.push(
+    ...(options.tier === "publish"
+      ? publishPreflight(env)
+      : iterationPreflight(env)),
+  );
+  if (!samePath(targetDirectory, join(workspaceRoot, "target"))) {
+    issues.push(
+      `${options.tier} cargo metadata target_directory must be the canonical workspace target: ${join(workspaceRoot, "target")}`,
+    );
+  }
+  const nextTier = {
+    targeted: "workspace (required hard gate)",
+    workspace: "executable (only when a runnable changed binary is needed)",
+    executable: "publish (only for release-equivalent output)",
+    publish: null,
+  }[options.tier];
+  return {
+    schemaVersion: 1,
+    tier: options.tier,
+    packages,
+    cwd: workspaceRoot,
+    targetDirectory,
+    argv,
+    preflight: { ready: issues.length === 0, issues },
+    requiresSlowConfirmation:
+      options.tier === "executable" || options.tier === "publish",
+    expectedWallTime:
+      options.tier === "executable"
+        ? "approximately 31 minutes after a warm changed-core edit"
+        : options.tier === "publish"
+          ? "approximately 58 minutes historically"
+          : null,
+    nextTier,
+  };
+}
+
+function loadMetadata(workspace, env) {
+  if (env.VERIFY_CORE_CHANGE_METADATA_JSON) {
+    return JSON.parse(env.VERIFY_CORE_CHANGE_METADATA_JSON);
+  }
+  const child = spawnSync(
+    env.VERIFY_CORE_CHANGE_CARGO ?? "cargo",
+    ["metadata", "--no-deps", "--format-version", "1"],
+    { cwd: workspace, env, encoding: "utf8" },
+  );
+  if (child.error) {
+    throw new UsageError(`cargo metadata could not start: ${child.error.message}`);
+  }
+  if (child.status !== 0) {
+    throw new UsageError(
+      `cargo metadata failed: ${(child.stderr || child.stdout || "").trim()}`,
+    );
+  }
+  try {
+    return JSON.parse(child.stdout);
+  } catch (error) {
+    throw new UsageError(`cargo metadata returned invalid JSON: ${error.message}`);
+  }
+}
+
+function printHumanPlan(plan) {
+  console.log(`tier: ${plan.tier}`);
+  console.log(`workspace: ${plan.cwd}`);
+  console.log(`target directory: ${plan.targetDirectory}`);
+  console.log(`command: ${plan.argv.map(JSON.stringify).join(" ")}`);
+  console.log(`next tier: ${plan.nextTier ?? "none"}`);
+}
+
+export function runCargo(plan, env = process.env, spawn = spawnSync) {
+  const child = spawn(plan.argv[0], plan.argv.slice(1), {
+    cwd: plan.cwd,
+    env,
+    stdio: "inherit",
+  });
+  if (child.error) {
+    throw new UsageError(`cargo could not start: ${child.error.message}`);
+  }
+  return child.status ?? 1;
+}
+
+export function main(argv = process.argv.slice(2), env = process.env) {
+  try {
+    const options = parseArgs(argv);
+    const workspace = resolve(env.VERIFY_CORE_CHANGE_WORKSPACE ?? defaultWorkspace);
+    const metadata = loadMetadata(workspace, env);
+    const plan = buildPlan(options, metadata, env);
+    if (options.printPlanJson) {
+      process.stdout.write(`${JSON.stringify(plan)}\n`);
+      return 0;
+    }
+    printHumanPlan(plan);
+    if (
+      plan.requiresSlowConfirmation &&
+      !options.confirmSlow
+    ) {
+      throw new UsageError(
+        `${options.tier} is intentionally slow; pass --confirm-slow to execute`,
+      );
+    }
+    if (!plan.preflight.ready) {
+      throw new UsageError(`preflight failed: ${plan.preflight.issues.join("; ")}`);
+    }
+    return runCargo(plan, env);
+  } catch (error) {
+    if (error instanceof UsageError || error instanceof SyntaxError) {
+      console.error(`[verify-core-change] ${error.message}`);
+      return 2;
+    }
+    throw error;
+  }
+}
+
+if (process.argv[1] && resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {
+  process.exitCode = main();
+}
