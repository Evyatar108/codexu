+                    [IO.File]::WriteAllBytes($state.Path, $state.Bytes)
+                } elseif ($onDiskHash -ne $state.OriginalHash) {
+                    throw (
+                        "concurrent content detected (SHA-256 $onDiskHash); preserved it instead of overwriting. " +
+                        "Save or reconcile the current file, then restore the expected original SHA-256 $($state.OriginalHash) before retrying."
+                    )
+                }
+                [IO.File]::SetLastWriteTimeUtc($state.Path, $state.LastWriteTimeUtc)
+                [IO.File]::SetAttributes($state.Path, $state.Attributes)
+            } catch {
+                $restoreFailures.Add("restore $($state.RelativePath): $($_.Exception.Message)")
+            }
+        }
+
+        foreach ($state in $probeState.States) {
+            $restoredHash = $null
+            try {
+                $restoredHash = Get-Sha256 ([IO.File]::ReadAllBytes($state.Path))
+                if ($restoredHash -ne $state.OriginalHash) { throw 'hash mismatch' }
+                if ([IO.File]::GetLastWriteTimeUtc($state.Path) -ne $state.LastWriteTimeUtc) { throw 'mtime mismatch' }
+                if ([IO.File]::GetAttributes($state.Path) -ne $state.Attributes) { throw 'attributes mismatch' }
+            } catch {
+                $restoreFailures.Add("verify $($state.RelativePath): $($_.Exception.Message)")
+            }
+            $fileResults.Add([ordered]@{
+                path = $state.RelativePath
+                beforeSha256 = $state.OriginalHash
+                editedSha256 = $state.EditedHash
+                restoredSha256 = $restoredHash
+                appliedLastWriteTimeUtc = if ($state.AppliedLastWriteTimeUtc) {
+                    $state.AppliedLastWriteTimeUtc.ToString('o')
+                } else {
+                    $null
+                }
+            })
+        }
+        $nestedClean = $false
+        $outerUnchanged = $false
+        try {
+            $nestedClean = -not [bool](Invoke-Git $probeState.RepositoryRoot @('status', '--porcelain=v1', '--untracked-files=all'))
+            if (-not $nestedClean) { throw 'repository is dirty' }
+        } catch {
+            $restoreFailures.Add("verify probe repository: $($_.Exception.Message)")
+        }
+        try {
+            $outerStatusAfter = Invoke-Git $CodexRoot @('status', '--porcelain=v1', '--untracked-files=all')
+            $outerUnchanged = $outerStatusBefore -ceq $outerStatusAfter
+            if (-not $outerUnchanged) { throw 'Outer wrapper status changed during probe.' }
+        } catch {
+            $restoreFailures.Add("verify outer wrapper: $($_.Exception.Message)")
+        }
+        $probeResult = [ordered]@{
+            files = @($fileResults)
+            nestedRepositoryCleanAfterRestore = $nestedClean
+            outerWrapperStatusUnchanged = $outerUnchanged
+        }
+        if ($restoreFailures.Count -gt 0) {
+            $restoreFailure = $restoreFailures -join '; '
+        }
+    }
+}
+
+if ($deferredProbeFailure) {
+    if ($restoreFailure) {
+        [Console]::Error.WriteLine("Probe restoration failed after '$deferredProbeFailure': $restoreFailure")
+        exit 4
+    }
+    [Console]::Error.WriteLine("[measure-build] $deferredProbeFailure")
