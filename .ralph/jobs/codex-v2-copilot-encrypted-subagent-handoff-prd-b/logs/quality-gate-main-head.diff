+function writeFakeCommand(directory, name, body) {
+  const commandName = process.platform === "win32" ? `${name}.cmd` : name;
+  const commandPath = join(directory, commandName);
+  writeFileSync(commandPath, body, "utf8");
+  if (process.platform !== "win32") chmodSync(commandPath, 0o755);
