-    rustflags      = $env:RUSTFLAGS
-}
-
-$csvPath = Join-Path $ArtifactsDir "$RunId.csv"
-$row | Export-Csv -Path $csvPath -NoTypeInformation -Encoding UTF8
-
-Write-Host ""
-Write-Host "[measure-build] ===== result ====="
-$row | Format-List
