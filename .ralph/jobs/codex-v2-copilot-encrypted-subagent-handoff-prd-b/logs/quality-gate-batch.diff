+fn count(source: &str, needle: &str) -> usize {
+    source.match_indices(needle).count()
+}
+
+fn section_between<'a>(source: &'a str, start: &str, end: &str) -> &'a str {
+    assert_eq!(
+        count(source, start),
+        1,
+        "expected one start boundary `{start}`"
+    );
+    let start_index = source.find(start).expect("start boundary checked above");
+    let tail = &source[start_index..];
+    let end_index = tail.find(end).unwrap_or_else(|| {
+        panic!("missing end boundary `{end}` after `{start}`");
+    });
+    &tail[..end_index]
+}
+
+fn section_with_leading_marker<'a>(
+    source: &'a str,
+    start: &str,
+    end: &str,
+    marker: &str,
+) -> &'a str {
+    assert_eq!(
+        count(source, start),
+        1,
+        "expected one start boundary `{start}`"
+    );
+    let start_index = source.find(start).expect("start boundary checked above");
+    let marker_index = source[..start_index]
+        .rfind(marker)
+        .unwrap_or_else(|| panic!("missing leading marker `{marker}` for `{start}`"));
+    let marker_gap = &source[marker_index + marker.len()..start_index];
+    assert!(
+        marker_gap
+            .lines()
+            .all(|line| line.trim().is_empty() || line.trim().starts_with("#[")),
+        "`{marker}` must directly own `{start}` except for attributes"
+    );
+    let tail = &source[marker_index..];
+    let end_index = marker.len()
+        + tail[marker.len()..].find(end).unwrap_or_else(|| {
+            panic!("missing end boundary `{end}` after `{start}`");
+        });
+    &tail[..end_index]
+}
+
+fn assert_ordered(section: &str, first: &str, second: &str) {
+    let first_index = section
+        .find(first)
+        .unwrap_or_else(|| panic!("missing `{first}`"));
+    let second_index = section
+        .find(second)
+        .unwrap_or_else(|| panic!("missing `{second}`"));
+    assert!(
+        first_index < second_index,
+        "expected `{first}` before `{second}`"
+    );
+}
